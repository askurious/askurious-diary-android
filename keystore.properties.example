# Copy to keystore.properties (never in Git) for a signed release build: ./gradlew bundleRelease
# The upload key, made once with Android Studio (Build > Generate Signed Bundle) or
# keytool -genkeypair -v -keystore upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# Play App Signing keeps the key the app is signed with; this one only uploads, and Google can replace it if lost.
storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=
