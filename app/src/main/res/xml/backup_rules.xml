<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: no backup of anything (android:allowBackup="false" already says so; this holds even if a
     manufacturer ignores it). See data_extraction_rules.xml for why. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
