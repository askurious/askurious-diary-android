<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".DiaryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Askurious"
        tools:targetApi="33">

        <!-- the WebView of the questionnaires sends no usage statistics to Google for this app (audit 2026-10-18, AND-10;
             named under "About the app") -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- taskAffinity="": no other app can slip its own screen into the task of the app (StrandHogg on old,
             unpatched Android versions). enableOnBackInvokedCallback: the back gesture shows the screen below before
             it goes back (predictive back, Android 14 and later; from Android 16 the default anyway) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the join link of a study (QR code): https://<host>/j/<code> opens the app (App Link; the server answers
                 /.well-known/assetlinks.json with the fingerprint of the signing key, DIARY_APP_FINGERPRINTS). The
                 hosts are the servers of Askurious and its brands (KNOWN_SERVERS in app/build.gradle.kts): the server
                 writes the brand's main address into the QR code (askurious.de/j/, polltergeist.de/j/), the
                 participants' addresses serve /j/ too. One filter per host: Android verifies the hosts of one filter
                 together, so one host that cannot be verified would cost the others their App Link. The join screen
                 takes the same links as its deep links (JOIN_LINKS in ui/Routes.kt). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="askurious.de" />
                <data android:pathPrefix="/j/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ask.askurious.de" />
                <data android:pathPrefix="/j/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="polltergeist.de" />
                <data android:pathPrefix="/j/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ask.polltergeist.de" />
                <data android:pathPrefix="/j/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="askurious" />
                <data android:host="join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EntryActivity"
            android:exported="false"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- the QR scanner (ZXing Android Embedded's CaptureActivity, clear of the system bars): it turns with the
             phone instead of always lying in landscape (with ScanOptions.setOrientationLocked(false), audit A10) -->
        <activity
            android:name=".ui.ScanActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <receiver android:name=".schedule.PromptReceiver" android:exported="false" />

        <receiver android:name=".schedule.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
